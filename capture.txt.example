# Paste a captured request here and rename this file to capture.txt.
#
# How to capture:
#   1. Open miniapps.ai signed in, open DevTools -> Network.
#   2. Toggle any tool in a conversation so a request to api.miniapps.ai fires.
#   3. Right-click it -> Copy -> "Copy as cURL" or "Copy as Python requests".
#   4. Paste the whole thing below. Field order and quoting do not matter.
#
# The parser needs exactly three values: the `jwt` cookie, the
# `__Host-miniapps.x-csrf-token` cookie, and the `x-csrf-token` header.
# `__cf_bm` is picked up when present but is optional.
#
# Verify a capture before deploying:  python reseed.py capture.txt

import requests

cookies = {
    '__Host-miniapps.x-csrf-token': '<short csrf value>',
    'jwt': '<jwt token>',
    '__cf_bm': '<cloudflare bot cookie, optional>',
}

headers = {
    'accept': 'application/json',
    'content-type': 'application/json',
    'origin': 'https://miniapps.ai',
    'referer': 'https://miniapps.ai/',
    'x-csrf-token': '<long csrf value>',
}

json_data = {
    'toolSettings': {
        'webSearch': True,
        'codeInterpreter': True,
        'canvas': False,
        'flightSearch': False,
        'locationSearch': False,
        'conversationLookup': False,
    },
}

response = requests.put(
    'https://api.miniapps.ai/conversations/<conversation-uuid>',
    cookies=cookies,
    headers=headers,
    json=json_data,
)
