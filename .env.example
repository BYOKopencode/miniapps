# ─── Auth for THIS API ────────────────────────────────────────────────
# Callers must send: Authorization: Bearer <key>   or   X-API-Key: <key>
MINIAPPS_API_KEY=sk-change-me
# Set to false only for local single-user development.
REQUIRE_API_KEY=true

# ─── miniapps.ai credentials (copy from a signed-in browser session) ──────────
# Easiest path: save the DevTools capture as capture.txt and let the app parse it.
# Otherwise set these three explicitly.
MINIAPPS_JWT=<jwt cookie>
MINIAPPS_CSRF_TOKEN=<x-csrf-token request header, long value>
MINIAPPS_CSRF_COOKIE=<__Host-miniapps.x-csrf-token cookie, short value>
# Optional. Cloudflare hands out a fresh one automatically, so leaving this
# blank is usually better than pinning a ~30-minute-old value.
MINIAPPS_CF_BM=
# Optional, informational only (derived from the JWT when omitted).
MINIAPPS_USER_EMAIL=

# ─── Multi-user (optional) ───────────────────────────────────────────
# A JSON array of users, either inline here or in users.json. See users.json.example.
# MINIAPPS_USERS=[{"api_key":"sk-a","name":"alice","jwt":"...","csrf_token":"...","csrf_cookie":"..."}]
MINIAPPS_USERS_FILE=users.json

# ─── Capture file (optional) ────────────────────────────────────────
MINIAPPS_CAPTURE_FILE=capture.txt
# MINIAPPS_CAPTURE=<paste a whole cURL/python-requests dump inline instead>

# ─── Upstream ─────────────────────────────────────────────────────
MINIAPPS_API_BASE=https://api.miniapps.ai
MINIAPPS_FRONTEND_BASE=https://miniapps.ai
REQUEST_TIMEOUT=60
# MINIAPPS_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36

# ─── Server ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=info
MCP_SERVER_NAME=miniapps-agent
MCP_SERVER_VERSION=1.0.0
