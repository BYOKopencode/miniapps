# ---------------------------------------------------------------------------
# Auth for THIS api (clients send it as `Authorization: Bearer <key>`)
# ---------------------------------------------------------------------------
MINIAPPS_API_KEY=paste-your-own-random-key
REQUIRE_API_KEY=true

# ---------------------------------------------------------------------------
# miniapps.ai session (copy from DevTools > Network > any api.miniapps.ai call)
# `jwt` and `__Host-miniapps.x-csrf-token` are cookies; `x-csrf-token` is a
# header. The two CSRF values are different strings and must be sent together.
# ---------------------------------------------------------------------------
MINIAPPS_JWT=paste-your-jwt-cookie
MINIAPPS_CSRF_TOKEN=paste-your-x-csrf-token-header
MINIAPPS_CSRF_COOKIE=paste-your-__Host-miniapps.x-csrf-token-cookie
# Optional. Cloudflare bot cookie, lives ~30 minutes. Safe to leave blank:
# a fresh one is issued on the first upstream call.
MINIAPPS_CF_BM=
MINIAPPS_USER_EMAIL=

# ---------------------------------------------------------------------------
# Alternative: let the server parse a pasted request instead of the vars above
# ---------------------------------------------------------------------------
# MINIAPPS_CAPTURE_FILE=capture.txt
# MINIAPPS_CAPTURE=

# ---------------------------------------------------------------------------
# Alternative: multiple sessions, each with its own API key
# ---------------------------------------------------------------------------
# MINIAPPS_USERS=[{"api_key":"key-a","name":"alice","jwt":"...","csrf_token":"...","csrf_cookie":"..."}]
# MINIAPPS_USERS_FILE=users.json

# ---------------------------------------------------------------------------
# Upstream + server
# ---------------------------------------------------------------------------
MINIAPPS_API_BASE=https://api.miniapps.ai
MINIAPPS_FRONTEND_BASE=https://miniapps.ai
REQUEST_TIMEOUT=30
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=info
MCP_SERVER_NAME=miniapps
MCP_SERVER_VERSION=1.0.0
